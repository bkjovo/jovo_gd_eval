# Copy to .env.local for local dev; set the same two values in the Vercel project.
#
# Both are read server-side only (src/lib/ratings.ts), never bundled for the browser.
# Neither has the NEXT_PUBLIC_ prefix. Do not add it; that would ship the key to users.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret)
# This key bypasses row-level security. It belongs only on the server.
SUPABASE_SERVICE_ROLE_KEY=
